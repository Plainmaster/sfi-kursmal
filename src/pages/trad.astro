---
import "../styles/global.css";
import kursB from "../data/kurs-b.json";
import kursC from "../data/kurs-c.json";
import kursD from "../data/kurs-d.json";

/* ---- Tier parameters (visual size per course level) ---- */
const TIERS = {
  sapling: {
    trunkWidthHalf: 9,
    crownRx: 110, crownRy: 85, crownCy: 110,
    rootStrokeMain: 4, rootStrokeSub: 2.5, rootCount: 5,
    leafR: 14,
    innerOrbit: 55, outerOrbit: 100,
    innerArcStart: 220, innerArcEnd: 320,
    outerArcStart: 205, outerArcEnd: 335,
    singleR: 80, singleArcStart: 205, singleArcEnd: 335,
  },
  medium: {
    trunkWidthHalf: 11,
    crownRx: 125, crownRy: 100, crownCy: 100,
    rootStrokeMain: 5, rootStrokeSub: 3.5, rootCount: 5,
    leafR: 16,
    innerOrbit: 60, outerOrbit: 110,
    innerArcStart: 215, innerArcEnd: 325,
    outerArcStart: 200, outerArcEnd: 340,
    singleR: 90, singleArcStart: 200, singleArcEnd: 340,
  },
  full: {
    trunkWidthHalf: 13,
    crownRx: 140, crownRy: 115, crownCy: 90,
    rootStrokeMain: 6, rootStrokeSub: 4.5, rootCount: 5,
    leafR: 17,
    innerOrbit: 65, outerOrbit: 118,
    innerArcStart: 210, innerArcEnd: 330,
    outerArcStart: 195, outerArcEnd: 345,
    singleR: 95, singleArcStart: 195, singleArcEnd: 345,
  },
};

const COURSE_TIER = { B: "sapling", C: "medium", D: "full" } as const;

/* ---- Bollkrona (foliage variant 4a) — per-tier ball cluster generator ---- */
function generateCrownBalls(rxC: number, ryC: number, cyC: number) {
  const cxC = 150;
  const spacing = 14, jitter = 7, rMin = 4.5, rMax = 8.5;
  const out: { x: number; y: number; r: number; shade: number }[] = [];
  const cols = Math.ceil(rxC / spacing) + 2;
  const rows = Math.ceil(ryC / spacing) + 2;
  const frac = (n: number) => n - Math.floor(n);
  for (let row = -rows; row <= rows; row++) {
    for (let col = -cols; col <= cols; col++) {
      const offset = row % 2 === 0 ? 0 : spacing / 2;
      const baseX = cxC + col * spacing + offset;
      const baseY = cyC + row * spacing * 0.86;
      const j1 = frac(Math.sin(row * 12.9898 + col * 78.233) * 43758.5453) - 0.5;
      const j2 = frac(Math.sin(row * 39.346 + col * 11.135) * 29853.123) - 0.5;
      const x = baseX + j1 * jitter;
      const y = baseY + j2 * jitter;
      const norm = ((x - cxC) / rxC) ** 2 + ((y - cyC) / ryC) ** 2;
      if (norm > 1.02) continue;
      const r = rMin + frac(Math.sin(row * 3.7 + col * 9.1) * 1000) * (rMax - rMin);
      const shade = Math.floor(frac(Math.sin(row * 5.3 + col * 2.7) * 500) * 3);
      out.push({
        x: Math.round(x * 10) / 10,
        y: Math.round(y * 10) / 10,
        r: Math.round(r * 10) / 10,
        shade,
      });
    }
  }
  return out;
}

const TIER_BALLS: Record<string, { x: number; y: number; r: number; shade: number }[]> = {
  sapling: generateCrownBalls(TIERS.sapling.crownRx, TIERS.sapling.crownRy, TIERS.sapling.crownCy),
  medium: generateCrownBalls(TIERS.medium.crownRx, TIERS.medium.crownRy, TIERS.medium.crownCy),
  full: generateCrownBalls(TIERS.full.crownRx, TIERS.full.crownRy, TIERS.full.crownCy),
};

/* ---- Build skills array from course data ---- */
function buildSkills(kursData: any) {
  return [
    { id: "hora", label: "Höra", sublabel: "Hörförståelse", color: "#D97706", colorLight: "#FEF3C7", colorMid: "#FBBF24", goals: kursData.domains.horforstaelse.goals },
    { id: "lasa", label: "Läsa", sublabel: "Läsförståelse", color: "#2563EB", colorLight: "#DBEAFE", colorMid: "#60A5FA", goals: kursData.domains.lasforstaelse.goals },
    { id: "tala", label: "Tala", sublabel: "Muntlig förmåga", color: "#16A34A", colorLight: "#DCFCE7", colorMid: "#4ADE80", goals: [...kursData.domains["muntlig-interaktion"].goals, ...kursData.domains["muntlig-produktion"].goals] },
    { id: "skriva", label: "Skriva", sublabel: "Skriftlig färdighet", color: "#DC2626", colorLight: "#FEE2E2", colorMid: "#F87171", goals: kursData.domains["skriftlig-fardighet"].goals },
    { id: "uttal", label: "Uttal", sublabel: "Uttal", color: "#0D9488", colorLight: "#CCFBF1", colorMid: "#2DD4BF", goals: kursData.domains.uttal.goals },
    { id: "grammatik", label: "Grammatik", sublabel: "Grammatik", color: "#7C3AED", colorLight: "#EDE9FE", colorMid: "#A78BFA", goals: kursData.domains.grammatik.goals },
  ];
}

/* ---- Leaf layout (tier-parameterized) ---- */
function computePositions(n: number, tier: typeof TIERS.medium) {
  const cx = 150, cy = 170;
  const positions: { x: number; y: number }[] = [];

  if (n <= 6) {
    const r = tier.singleR;
    const arcStart = tier.singleArcStart, arcEnd = tier.singleArcEnd;
    for (let i = 0; i < n; i++) {
      const angle = n === 1 ? 270 : arcStart + ((arcEnd - arcStart) / (n - 1)) * i;
      const rad = (angle * Math.PI) / 180;
      positions.push({ x: Math.round(cx + r * Math.cos(rad)), y: Math.round(cy + r * Math.sin(rad)) });
    }
  } else {
    const inner = Math.floor(n / 2);
    const outer = n - inner;
    const r1 = tier.innerOrbit, s1Start = tier.innerArcStart, s1End = tier.innerArcEnd;
    for (let i = 0; i < inner; i++) {
      const angle = inner === 1 ? 270 : s1Start + ((s1End - s1Start) / (inner - 1)) * i;
      const rad = (angle * Math.PI) / 180;
      positions.push({ x: Math.round(cx + r1 * Math.cos(rad)), y: Math.round(cy + r1 * Math.sin(rad)) });
    }
    const r2 = tier.outerOrbit, s2Start = tier.outerArcStart, s2End = tier.outerArcEnd;
    for (let i = 0; i < outer; i++) {
      const angle = outer === 1 ? 270 : s2Start + ((s2End - s2Start) / (outer - 1)) * i;
      const rad = (angle * Math.PI) / 180;
      positions.push({ x: Math.round(cx + r2 * Math.cos(rad)), y: Math.round(cy + r2 * Math.sin(rad)) });
    }
  }
  return positions;
}

function branchPath(lx: number, ly: number) {
  const tx = 150, ty = 170;
  const cp1x = tx + (lx - tx) * 0.25;
  const cp1y = ty - 10;
  const cp2x = lx - (lx - tx) * 0.15;
  const cp2y = ly + (ty - ly) * 0.2;
  return `M${tx},${ty} C${cp1x},${cp1y} ${cp2x},${cp2y} ${lx},${ly}`;
}

/* ---- Sub-branches for C and D (fork off main branch) ---- */
function subBranches(lx: number, ly: number, tier: string, idx: number): string[] {
  if (tier === "sapling") return [];
  const tx = 150, ty = 170;
  // Midpoint of the branch
  const mx = tx + (lx - tx) * 0.55;
  const my = ty + (ly - ty) * 0.45;
  // Perpendicular direction for fork
  const dx = lx - tx, dy = ly - ty;
  const len = Math.sqrt(dx * dx + dy * dy) || 1;
  const px = -dy / len, py = dx / len;
  const forkLen = tier === "full" ? 18 : 13;
  const side = idx % 2 === 0 ? 1 : -1;
  const paths: string[] = [];
  // One fork on medium, two on full
  const fx = mx + px * forkLen * side;
  const fy = my + py * forkLen * side;
  paths.push(`M${Math.round(mx)},${Math.round(my)} Q${Math.round((mx+fx)/2)},${Math.round((my+fy)/2 - 5)} ${Math.round(fx)},${Math.round(fy)}`);
  if (tier === "full") {
    const mx2 = tx + (lx - tx) * 0.35;
    const my2 = ty + (ly - ty) * 0.28;
    const fx2 = mx2 + px * forkLen * 0.8 * -side;
    const fy2 = my2 + py * forkLen * 0.8 * -side;
    paths.push(`M${Math.round(mx2)},${Math.round(my2)} Q${Math.round((mx2+fx2)/2)},${Math.round((my2+fy2)/2 - 3)} ${Math.round(fx2)},${Math.round(fy2)}`);
  }
  return paths;
}

/* ---- Build data for all three courses ---- */
const COURSES = ["B", "C", "D"] as const;
const courseData = { B: kursB, C: kursC, D: kursD };

const allTreesData: Record<string, any[]> = {};
const allSkills: Record<string, any[]> = {};
const allGoalTexts: Record<string, Record<string, string>> = {};
const allSkillsClient: Record<string, any[]> = {};

for (const course of COURSES) {
  const tier = TIERS[COURSE_TIER[course]];
  const skills = buildSkills(courseData[course]);
  allSkills[course] = skills;

  allTreesData[course] = skills.map((skill) => {
    const pos = computePositions(skill.goals.length, tier);
    return {
      ...skill,
      tier,
      course,
      tierName: COURSE_TIER[course],
      balls: TIER_BALLS[COURSE_TIER[course]],
      leaves: skill.goals.map((g: any, i: number) => ({
        id: g.id,
        text: g.text,
        x: pos[i].x,
        y: pos[i].y,
        branch: branchPath(pos[i].x, pos[i].y),
        subBranches: subBranches(pos[i].x, pos[i].y, COURSE_TIER[course], i),
        bobDelay: (i * 0.4).toFixed(1),
      })),
    };
  });

  const texts: Record<string, string> = {};
  skills.forEach((s) => s.goals.forEach((g: any) => { texts[g.id] = g.text; }));
  allGoalTexts[course] = texts;

  allSkillsClient[course] = skills.map((s) => ({
    id: s.id, label: s.label, color: s.color,
    goalIds: s.goals.map((g: any) => g.id),
  }));
}

/* ---- Radar layout — same size, density increases per course ---- */
const RADAR_CX = 150, RADAR_CY = 150, RADAR_R = 110;

/* Grid ring counts increase with CEFR level — denser = more advanced */
const RADAR_CONFIG = {
  B: { rings: 4, prev: [] as string[], prevPcts: [] as number[] },
  C: { rings: 6, prev: ["B"], prevPcts: [0.6] },
  D: { rings: 8, prev: ["B", "C"], prevPcts: [0.45, 0.72] },
} as const;

const PREV_COLORS: Record<string, string> = { B: "#06B6D4", C: "#8B5CF6" };

/* Radar axis order — Grammatik placed at the bottom so it has horizontal room.
   Tree card grid uses buildSkills() order and is unaffected by this. */
const RADAR_ORDER = ["hora", "lasa", "tala", "grammatik", "uttal", "skriva"] as const;

const radarAxes = RADAR_ORDER.map((skillId, i) => {
  const s = allSkills["B"].find((x: any) => x.id === skillId);
  const angleDeg = -90 + i * 60;
  const rad = (angleDeg * Math.PI) / 180;
  const cos = Math.cos(rad), sin = Math.sin(rad);
  const anchor = i === 0 || i === 3 ? "middle" : i < 3 ? "start" : "end";
  const lblR = RADAR_R + 22;
  return {
    id: s.id, label: s.label, color: s.color,
    ex: Math.round(RADAR_CX + RADAR_R * cos),
    ey: Math.round(RADAR_CY + RADAR_R * sin),
    lx: Math.round(RADAR_CX + lblR * cos),
    ly: Math.round(RADAR_CY + lblR * sin + (i === 0 ? -4 : i === 3 ? 16 : 5)),
    anchor,
  };
});

/* Smooth closed Catmull-Rom-to-Bezier path through N points — used for radar data shapes */
function smoothClosedPath(points: { x: number; y: number }[], tension = 0.22) {
  const n = points.length;
  if (n < 2) return "";
  let d = `M${points[0].x.toFixed(1)},${points[0].y.toFixed(1)}`;
  for (let i = 0; i < n; i++) {
    const p0 = points[(i - 1 + n) % n];
    const p1 = points[i];
    const p2 = points[(i + 1) % n];
    const p3 = points[(i + 2) % n];
    const cp1x = p1.x + (p2.x - p0.x) * tension;
    const cp1y = p1.y + (p2.y - p0.y) * tension;
    const cp2x = p2.x - (p3.x - p1.x) * tension;
    const cp2y = p2.y - (p3.y - p1.y) * tension;
    d += ` C${cp1x.toFixed(1)},${cp1y.toFixed(1)} ${cp2x.toFixed(1)},${cp2y.toFixed(1)} ${p2.x.toFixed(1)},${p2.y.toFixed(1)}`;
  }
  return d + " Z";
}

function radarPath(pcts: number[], maxR: number) {
  const points = pcts.map((p, i) => {
    const rad = ((-90 + i * 60) * Math.PI) / 180;
    return {
      x: RADAR_CX + maxR * p * Math.cos(rad),
      y: RADAR_CY + maxR * p * Math.sin(rad),
    };
  });
  return smoothClosedPath(points);
}

const RADAR_INIT_PATH = `M${RADAR_CX},${RADAR_CY} Z`;

/* ---- Tab classes (Tailwind-safe, no dynamic string interpolation) ---- */
const tabClasses = {
  B: { active: "border-cyan-600 text-cyan-700 bg-cyan-50 shadow-sm", inactive: "border-transparent text-gray-400 hover:text-gray-600" },
  C: { active: "border-violet-600 text-violet-700 bg-violet-50 shadow-sm", inactive: "border-transparent text-gray-400 hover:text-gray-600" },
  D: { active: "border-rose-600 text-rose-700 bg-rose-50 shadow-sm", inactive: "border-transparent text-gray-400 hover:text-gray-600" },
};
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Min utveckling</title>
  </head>
  <body class="font-sans bg-gradient-to-br from-stone-50 via-emerald-50/30 to-amber-50/20 text-gray-900 min-h-screen">
    <!-- Header -->
    <header class="bg-white/70 backdrop-blur-xl border-b border-white/40 sticky top-0 z-20 shadow-sm">
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-400 via-green-500 to-emerald-700 flex items-center justify-center shadow-md shadow-emerald-200/60 ring-1 ring-white/40">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 3v18h18" />
              <path d="M7 14l4-4 4 4 5-6" />
            </svg>
          </div>
          <div>
            <h1 class="text-lg font-bold bg-gradient-to-r from-emerald-800 to-stone-700 bg-clip-text text-transparent leading-tight">Min utveckling</h1>
            <p class="text-xs text-stone-500" id="tree-header-subtitle">Kurs B &middot; Dina förmågor växer</p>
          </div>
        </div>
        <a href="/" class="text-sm text-emerald-700 hover:text-emerald-900 font-medium px-3 py-1.5 rounded-lg hover:bg-emerald-50 transition-all">
          Mina kurser &rarr;
        </a>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 py-6 space-y-8">
      <!-- Tab navigation -->
      <nav class="flex justify-center gap-2 mb-6" role="tablist" aria-label="Välj kurs">
        {COURSES.map((course) => {
          const isActive = course === "B";
          return (
            <button
              class={`tree-tab px-5 py-2.5 text-sm font-semibold rounded-xl border-2 transition-all duration-200 ${isActive ? tabClasses[course].active + " shadow-sm" : tabClasses[course].inactive}`}
              data-course={course}
              role="tab"
              aria-selected={isActive ? "true" : "false"}
              aria-controls={`tree-panel-${course}`}
            >
              Kurs {course}
            </button>
          );
        })}
      </nav>

      <!-- Course panels -->
      {COURSES.map((course) => {
        const tier = TIERS[COURSE_TIER[course]];
        return (
          <div id={`tree-panel-${course}`} class={`course-tree-panel ${course !== "B" ? "hidden" : ""}`} role="tabpanel">
            <!-- Radar chart for this course -->
            <section class="flex justify-center">
              <div class="bg-white/60 backdrop-blur-sm rounded-2xl shadow-lg shadow-stone-200/40 border border-white/50 p-5 w-full max-w-sm ring-1 ring-stone-100/50">
                <h2 class="text-center text-sm font-semibold text-stone-600 mb-3 tracking-wide uppercase">Min utveckling</h2>
                <svg id={`radar-${course}`} viewBox="-25 -10 350 320" class="w-full">
                  {(() => {
                    const cfg = RADAR_CONFIG[course];
                    const ringSteps = Array.from({ length: cfg.rings }, (_, i) => (i + 1) / cfg.rings);
                    return (
                      <Fragment>
                        {/* Density grid — concentric circles */}
                        {ringSteps.map((pct) => (
                          <circle
                            cx={RADAR_CX}
                            cy={RADAR_CY}
                            r={Math.round(RADAR_R * pct * 10) / 10}
                            fill="none"
                            stroke={pct === 1 ? "#A8A29E" : "#D6D3D1"}
                            stroke-width={pct === 1 ? "1.8" : "1.1"}
                            opacity={pct === 1 ? "1" : "0.75"}
                          />
                        ))}

                        {/* Axis lines */}
                        {radarAxes.map((a) => (
                          <line x1={RADAR_CX} y1={RADAR_CY} x2={a.ex} y2={a.ey} stroke="#B8B2AB" stroke-width="1.4" />
                        ))}

                        {/* Previous course boundary rings + baseline shapes */}
                        {cfg.prev.map((prevCourse: string, pi: number) => {
                          const color = PREV_COLORS[prevCourse];
                          const boundaryPct = cfg.prevPcts[pi];
                          return (
                            <Fragment>
                              <circle
                                cx={RADAR_CX}
                                cy={RADAR_CY}
                                r={Math.round(RADAR_R * boundaryPct * 10) / 10}
                                fill="none"
                                stroke={color}
                                stroke-width="1.5"
                                stroke-dasharray="6 4"
                                opacity="0.5"
                              />
                              <text
                                x={RADAR_CX + RADAR_R * boundaryPct + 5}
                                y={RADAR_CY - 3}
                                font-size="13"
                                font-weight="800"
                                fill={color}
                                opacity="0.85"
                              >{prevCourse}</text>
                              <path
                                id={`radar-baseline-${prevCourse}-on-${course}`}
                                d={RADAR_INIT_PATH}
                                fill={`${color}15`}
                                stroke={color}
                                stroke-width="1.5"
                                stroke-linejoin="round"
                                opacity="0.5"
                              />
                            </Fragment>
                          );
                        })}

                        {/* Current course completion shape — smooth path */}
                        <path
                          id={`radar-polygon-${course}`}
                          d={RADAR_INIT_PATH}
                          fill="rgba(34,197,94,0.12)"
                          stroke="#22C55E"
                          stroke-width="2.5"
                          stroke-linejoin="round"
                        />

                        {/* Dots and labels */}
                        {radarAxes.map((a) => (
                          <circle id={`radar-dot-${a.id}-${course}`} cx={RADAR_CX} cy={RADAR_CY} r="5" fill={a.color} />
                        ))}
                        {radarAxes.map((a) => (
                          <text x={a.lx} y={a.ly} text-anchor={a.anchor} font-size="15" font-weight="700" fill={a.color}>{a.label}</text>
                        ))}
                      </Fragment>
                    );
                  })()}
                </svg>
              </div>
            </section>

            {/* "Jag har klarat" buttons for inheriting previous course completion */}
            {course === "C" && (
              <div id="inherit-B-on-C" class="hidden flex justify-center mt-4">
                <button
                  class="inherit-btn px-4 py-2 text-sm font-medium rounded-lg border-2 border-cyan-300 bg-cyan-50 text-cyan-800 hover:bg-cyan-100 transition-colors"
                  data-fill-course="B"
                  data-on-course="C"
                >
                  Jag har klarat Kurs B — fyll i alla mål
                </button>
              </div>
            )}
            {course === "D" && (
              <div id="inherit-on-D" class="hidden flex justify-center gap-3 mt-4 flex-wrap">
                <button
                  class="inherit-btn px-4 py-2 text-sm font-medium rounded-lg border-2 border-cyan-300 bg-cyan-50 text-cyan-800 hover:bg-cyan-100 transition-colors"
                  data-fill-course="B"
                  data-on-course="D"
                  id="inherit-B-on-D-btn"
                >
                  Jag har klarat Kurs B
                </button>
                <button
                  class="inherit-btn px-4 py-2 text-sm font-medium rounded-lg border-2 border-violet-300 bg-violet-50 text-violet-800 hover:bg-violet-100 transition-colors"
                  data-fill-course="C"
                  data-on-course="D"
                  id="inherit-C-on-D-btn"
                >
                  Jag har klarat Kurs C
                </button>
              </div>
            )}

            <!-- Trees grid for this course -->
            <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
              {allTreesData[course].map((tree: any) => (
                <div class="tree-card bg-white/60 backdrop-blur-sm rounded-2xl shadow-lg shadow-stone-200/30 border border-white/50 ring-1 ring-stone-100/30 overflow-hidden hover:shadow-xl hover:shadow-stone-200/40 transition-all duration-300" data-skill={tree.id} data-course={course} data-tree-state="empty">
                  <!-- Card header -->
                  <div class="px-4 pt-4 pb-1 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                      <span class="w-3 h-3 rounded-full inline-block" style={`background:${tree.color}`} />
                      <h2 class="font-bold text-stone-800">{tree.label}</h2>
                      <span class="text-xs text-stone-400">{tree.sublabel}</span>
                    </div>
                    <span class="text-xs font-medium text-stone-500" data-tree-progress={`${course}-${tree.id}`}>
                      0 av {tree.goals.length}
                    </span>
                  </div>

                  <!-- Progress bar -->
                  <div class="mx-4 mt-1 h-1 bg-stone-100 rounded-full overflow-hidden">
                    <div
                      class="h-full rounded-full transition-all duration-500 ease-out"
                      style={`background:${tree.color};width:0%`}
                      data-progress-bar={`${course}-${tree.id}`}
                    />
                  </div>

                  <!-- Tree SVG — extended viewBox to fit C/D crown fully -->
                  <svg viewBox="-10 -45 320 405" class="w-full tree-svg">
                    <!-- Roots — parameterized by tier.rootCount -->
                    <path d="M138,297 C125,310 105,320 82,328" stroke="#7C5B2A" stroke-width={String(tier.rootStrokeMain)} fill="none" stroke-linecap="round" />
                    <path d="M162,297 C175,310 195,320 218,328" stroke="#7C5B2A" stroke-width={String(tier.rootStrokeMain)} fill="none" stroke-linecap="round" />
                    {tier.rootCount >= 3 && (
                      <path d="M150,302 C150,322 149,338 148,348" stroke="#7C5B2A" stroke-width={String(tier.rootStrokeSub)} fill="none" stroke-linecap="round" />
                    )}
                    {tier.rootCount >= 5 && (
                      <Fragment>
                        <path d="M144,300 C138,316 127,332 118,340" stroke="#7C5B2A" stroke-width={String(tier.rootStrokeSub)} fill="none" stroke-linecap="round" />
                        <path d="M156,300 C162,316 173,332 182,340" stroke="#7C5B2A" stroke-width={String(tier.rootStrokeSub)} fill="none" stroke-linecap="round" />
                      </Fragment>
                    )}
                    {tier.rootCount >= 7 && (
                      <Fragment>
                        <path d="M132,298 C118,308 98,314 75,316" stroke="#7C5B2A" stroke-width={String(tier.rootStrokeSub - 1)} fill="none" stroke-linecap="round" />
                        <path d="M168,298 C182,308 202,314 225,316" stroke="#7C5B2A" stroke-width={String(tier.rootStrokeSub - 1)} fill="none" stroke-linecap="round" />
                      </Fragment>
                    )}

                    <!-- Trunk — parameterized width -->
                    <path
                      d={`M${150-tier.trunkWidthHalf},299 C${150-tier.trunkWidthHalf-3},267 ${150-tier.trunkWidthHalf-5},232 ${150-tier.trunkWidthHalf-2},202 C${150-3},187 ${150-4},177 150,172 C${150+4},177 ${150+3},187 ${150+tier.trunkWidthHalf+2},202 C${150+tier.trunkWidthHalf+5},232 ${150+tier.trunkWidthHalf+3},267 ${150+tier.trunkWidthHalf},299 Z`}
                      fill="#6B4226"
                    />
                    <path d="M148,282 C147,260 146,238 148,218" stroke="#5A3520" stroke-width="0.7" fill="none" opacity="0.35" />
                    <path d="M153,278 C154,258 153,238 151,215" stroke="#5A3520" stroke-width="0.7" fill="none" opacity="0.35" />

                    <!-- Crown — bollkrona (foliage variant 4a) -->
                    <g class="crown-balls" data-crown-balls={`${course}-${tree.id}`} data-tree-state="empty">
                      {tree.balls.map((b: any) => {
                        const fill = b.shade === 0 ? tree.colorLight : b.shade === 1 ? tree.colorMid : tree.color;
                        const op = b.shade === 2 ? "0.82" : b.shade === 1 ? "0.95" : "1";
                        return <circle cx={b.x} cy={b.y} r={b.r} fill={fill} opacity={op} />;
                      })}
                    </g>

                    <!-- Branches, sub-branches, and leaves -->
                    {tree.leaves.map((leaf: any, i: number) => (
                      <g>
                        <path d={leaf.branch} stroke="#A88B5C" stroke-width="2" fill="none" stroke-linecap="round" class="branch-line" data-branch-for={leaf.id} />
                        {/* Sub-branches for C (medium) and D (full) */}
                        {leaf.subBranches.map((sb: string) => (
                          <path d={sb} stroke="#C4A97D" stroke-width="1.2" fill="none" stroke-linecap="round" opacity="0.7" />
                        ))}
                        <circle
                          cx={leaf.x} cy={leaf.y} r={String(tier.leafR)}
                          class="leaf-node"
                          data-goal-id={leaf.id}
                          data-skill={tree.id}
                          data-course={course}
                          data-checked="false"
                          style={`--lc:${tree.color};--lcl:${tree.colorLight};--lcm:${tree.colorMid};--bob-delay:${leaf.bobDelay}s`}
                          tabindex="0"
                          role="checkbox"
                          aria-checked="false"
                          aria-label={leaf.text}
                        />
                        <text x={leaf.x} y={leaf.y + 5} text-anchor="middle" font-size="11" font-weight="700" class="leaf-num" data-num-for={leaf.id} fill={tree.color}>
                          {i + 1}
                        </text>
                      </g>
                    ))}
                  </svg>

                  <!-- Goal text panel -->
                  <div class="px-4 pb-4 -mt-2">
                    <div
                      class="goal-panel min-h-[2.75rem] bg-stone-50/80 backdrop-blur-sm rounded-xl px-3 py-2 text-sm text-stone-400 italic transition-all duration-300 border border-stone-100"
                      data-goal-panel={`${course}-${tree.id}`}
                    >
                      Tryck på en frukt för att se målet
                    </div>
                  </div>
                </div>
              ))}
            </section>
          </div>
        );
      })}
    </main>

    <style>
      /* ---- Leaf nodes ---- */
      .leaf-node {
        fill: #E7E5E4;
        stroke: var(--lc);
        stroke-width: 2;
        stroke-dasharray: 5 3;
        cursor: pointer;
        transition:
          fill 0.35s ease,
          stroke-width 0.35s ease,
          stroke-dasharray 0.35s ease,
          filter 0.35s ease;
      }

      .leaf-node:hover,
      .leaf-node:focus-visible {
        filter: drop-shadow(0 0 8px var(--lcm));
        outline: none;
      }

      .leaf-node[data-checked="true"] {
        fill: var(--lc);
        stroke: rgba(255, 255, 255, 0.5);
        stroke-width: 2.5;
        stroke-dasharray: none;
        filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.18));
      }

      /* Leaf numbers */
      .leaf-num {
        pointer-events: none;
        transition: fill 0.3s ease;
      }

      /* Crown — bollkrona, three states */
      .crown-balls {
        transition: opacity 0.5s ease, filter 0.5s ease;
      }
      .crown-balls[data-tree-state="empty"] {
        opacity: 0.55;
        filter: saturate(0.18) brightness(1.05);
      }
      .crown-balls[data-tree-state="started"] {
        opacity: 0.92;
        filter: saturate(0.85);
      }
      .crown-balls[data-tree-state="done"] {
        opacity: 1;
        filter: saturate(1.05);
      }

      /* Tree card border accent reflects state */
      .tree-card[data-tree-state="empty"] {
        border-color: rgba(231, 229, 228, 0.7);
      }
      .tree-card[data-tree-state="done"] {
        border-color: rgba(34, 197, 94, 0.45);
        box-shadow: 0 4px 24px -4px rgba(34, 197, 94, 0.18), 0 1px 3px rgba(0, 0, 0, 0.04);
      }

      /* Branch lines */
      .branch-line {
        transition:
          stroke 0.4s ease,
          stroke-width 0.4s ease;
      }

      .branch-line[data-checked="true"] {
        stroke: #7C5B2A;
        stroke-width: 3;
      }

      /* Gentle bobbing for unchecked leaves */
      @keyframes gentle-bob {
        0%,
        100% {
          translate: 0 0;
        }
        50% {
          translate: 0 -3px;
        }
      }

      .leaf-node[data-checked="false"] {
        animation: gentle-bob 3s ease-in-out infinite;
        animation-delay: var(--bob-delay, 0s);
      }
      .leaf-node[data-checked="true"] {
        animation: none;
      }

      /* Pulse when toggled */
      @keyframes check-pop {
        0% {
          transform: scale(1);
        }
        40% {
          transform: scale(1.25);
        }
        100% {
          transform: scale(1);
        }
      }
      .leaf-pop {
        animation: check-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      }

      /* Radar shape */
      [id^="radar-polygon"],
      [id^="radar-baseline"] {
        transition: d 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
      }

      /* Tree SVG sizing */
      .tree-svg {
        max-height: 340px;
      }

      /* Print: hide interactive tree page */
      @media print {
        body {
          display: none;
        }
      }
    </style>

    <script define:vars={{ allSkillsClient, allGoalTexts, RADAR_CONFIG, PREV_COLORS, RADAR_R }}>
      /* ---- Multi-course localStorage (shared with checklist) ---- */
      const COURSES = ["B", "C", "D"];
      const PREV_COURSES = { C: ["B"], D: ["B", "C"] };
      const states = {};

      function loadState(course) {
        try { return JSON.parse(localStorage.getItem(`sfi-checklist-${course}`) || "{}"); } catch { return {}; }
      }
      function saveState(course, st) {
        try { localStorage.setItem(`sfi-checklist-${course}`, JSON.stringify(st)); } catch {}
      }

      COURSES.forEach(c => { states[c] = loadState(c); });

      /* ---- Read course from URL param ---- */
      const urlCourse = new URLSearchParams(window.location.search).get("course");
      const initialCourse = (urlCourse && COURSES.includes(urlCourse)) ? urlCourse : "B";

      /* ---- Tab switching ---- */
      let activeCourse = initialCourse;

      const treeTabs = document.querySelectorAll('.tree-tab');
      const treePanels = document.querySelectorAll('.course-tree-panel');
      const headerSubtitle = document.getElementById('tree-header-subtitle');

      const tabActiveClasses = {
        B: ["border-cyan-600", "text-cyan-700", "bg-cyan-50", "shadow-sm"],
        C: ["border-violet-600", "text-violet-700", "bg-violet-50", "shadow-sm"],
        D: ["border-rose-600", "text-rose-700", "bg-rose-50", "shadow-sm"],
      };
      const tabInactiveClasses = ["border-transparent", "text-gray-400", "hover:text-gray-600"];

      const backLink = document.querySelector('a[href="/"]');

      function switchTreeTab(course) {
        activeCourse = course;

        treePanels.forEach(p => p.classList.toggle('hidden', p.id !== `tree-panel-${course}`));

        treeTabs.forEach(t => {
          const tc = t.dataset.course;
          Object.values(tabActiveClasses).forEach(cls => cls.forEach(c => t.classList.remove(c)));
          tabInactiveClasses.forEach(c => t.classList.remove(c));

          if (tc === course) {
            tabActiveClasses[course].forEach(c => t.classList.add(c));
            t.setAttribute("aria-selected", "true");
          } else {
            tabInactiveClasses.forEach(c => t.classList.add(c));
            t.setAttribute("aria-selected", "false");
          }
        });

        if (headerSubtitle) {
          headerSubtitle.textContent = `Kurs ${course} \u00B7 Dina f\u00F6rm\u00E5gor v\u00E4xer`;
        }

        // Sync back-link with active course
        if (backLink) {
          backLink.setAttribute('href', `/?course=${course}`);
        }

        // Show/hide inherit buttons based on previous course completion
        updateInheritButtons();
      }

      treeTabs.forEach(t => {
        t.addEventListener('click', () => switchTreeTab(t.dataset.course));
      });

      /* ---- Init all courses' leaf states on page load ---- */
      COURSES.forEach(course => {
        const panel = document.getElementById(`tree-panel-${course}`);
        if (!panel) return;

        panel.querySelectorAll('.leaf-node').forEach(leaf => {
          const id = leaf.dataset.goalId;
          if (states[course][id]) {
            leaf.setAttribute('data-checked', 'true');
            leaf.setAttribute('aria-checked', 'true');
            const num = panel.querySelector(`[data-num-for="${id}"]`);
            if (num) num.setAttribute('fill', 'white');
            const branch = panel.querySelector(`[data-branch-for="${id}"]`);
            if (branch) branch.setAttribute('data-checked', 'true');
          }
        });
      });

      /* ---- Click / keyboard handling — scoped to course ---- */
      document.querySelectorAll('.leaf-node').forEach(leaf => {
        function toggle() {
          const id = leaf.dataset.goalId;
          const skill = leaf.dataset.skill;
          const course = leaf.dataset.course;
          const wasChecked = leaf.getAttribute('data-checked') === 'true';
          const nowChecked = !wasChecked;

          if (nowChecked) { states[course][id] = true; }
          else { delete states[course][id]; }
          saveState(course, states[course]);

          leaf.setAttribute('data-checked', String(nowChecked));
          leaf.setAttribute('aria-checked', String(nowChecked));

          leaf.classList.remove('leaf-pop');
          void leaf.offsetWidth;
          leaf.classList.add('leaf-pop');

          const panel = document.getElementById(`tree-panel-${course}`);
          const num = panel.querySelector(`[data-num-for="${id}"]`);
          if (num) num.setAttribute('fill', nowChecked ? 'white' : '');

          const branch = panel.querySelector(`[data-branch-for="${id}"]`);
          if (branch) branch.setAttribute('data-checked', String(nowChecked));

          showGoalText(course, skill, id, nowChecked);
          updateProgress(course, skill);
          updateCrown(course, skill);
          updateRadar(course);
        }

        leaf.addEventListener('click', toggle);
        leaf.addEventListener('keydown', (e) => {
          if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); toggle(); }
        });
      });

      /* ---- Goal text panel — course-scoped ---- */
      function showGoalText(course, skillId, goalId, isChecked) {
        const panel = document.querySelector(`[data-goal-panel="${course}-${skillId}"]`);
        if (!panel) return;
        const courseTexts = allGoalTexts[course] || {};
        const text = courseTexts[goalId] || "";
        const check = isChecked ? "\u2713 " : "";
        panel.textContent = `${check}${text}`;
        panel.classList.remove('italic', 'text-stone-400');
        panel.classList.add('text-stone-700');
      }

      /* ---- Progress — course-scoped ---- */
      function updateProgress(course, skillId) {
        const skills = allSkillsClient[course];
        if (!skills) return;
        const skill = skills.find(s => s.id === skillId);
        if (!skill) return;
        const checked = skill.goalIds.filter(id => states[course][id]).length;
        const total = skill.goalIds.length;
        const pct = Math.round((checked / total) * 100);

        const progressEl = document.querySelector(`[data-tree-progress="${course}-${skillId}"]`);
        if (progressEl) progressEl.textContent = `${checked} av ${total}`;

        const bar = document.querySelector(`[data-progress-bar="${course}-${skillId}"]`);
        if (bar) bar.style.width = `${pct}%`;
      }

      /* ---- Crown state — empty / started / done ---- */
      function updateCrown(course, skillId) {
        const skills = allSkillsClient[course];
        if (!skills) return;
        const skill = skills.find(s => s.id === skillId);
        if (!skill) return;
        const total = skill.goalIds.length;
        const checked = skill.goalIds.filter(id => states[course][id]).length;
        const state = checked === 0 ? "empty" : checked >= total ? "done" : "started";

        const crown = document.querySelector(`[data-crown-balls="${course}-${skillId}"]`);
        if (crown) crown.setAttribute('data-tree-state', state);

        const card = document.querySelector(`.tree-card[data-skill="${skillId}"][data-course="${course}"]`);
        if (card) card.setAttribute('data-tree-state', state);
      }

      /* ---- Radar chart — same size, density varies ---- */
      const rcx = 150, rcy = 150;

      function smoothClosedPath(points) {
        const n = points.length;
        if (n < 2) return '';
        const tension = 0.22;
        let d = `M${points[0].x.toFixed(1)},${points[0].y.toFixed(1)}`;
        for (let i = 0; i < n; i++) {
          const p0 = points[(i - 1 + n) % n];
          const p1 = points[i];
          const p2 = points[(i + 1) % n];
          const p3 = points[(i + 2) % n];
          const cp1x = p1.x + (p2.x - p0.x) * tension;
          const cp1y = p1.y + (p2.y - p0.y) * tension;
          const cp2x = p2.x - (p3.x - p1.x) * tension;
          const cp2y = p2.y - (p3.y - p1.y) * tension;
          d += ` C${cp1x.toFixed(1)},${cp1y.toFixed(1)} ${cp2x.toFixed(1)},${cp2y.toFixed(1)} ${p2.x.toFixed(1)},${p2.y.toFixed(1)}`;
        }
        return d + ' Z';
      }

      function radarPath(pcts, maxR) {
        const points = pcts.map((p, i) => {
          const rad = ((-90 + i * 60) * Math.PI) / 180;
          return {
            x: rcx + maxR * p * Math.cos(rad),
            y: rcy + maxR * p * Math.sin(rad),
          };
        });
        return smoothClosedPath(points);
      }

      const RADAR_ORDER = ["hora", "lasa", "tala", "grammatik", "uttal", "skriva"];

      function getCoursePcts(course) {
        const skills = allSkillsClient[course];
        if (!skills) return [0,0,0,0,0,0];
        return RADAR_ORDER.map(skillId => {
          const s = skills.find(x => x.id === skillId);
          if (!s) return 0;
          const checked = s.goalIds.filter(id => states[course][id]).length;
          return checked / s.goalIds.length;
        });
      }

      function updateRadar(course) {
        const skills = allSkillsClient[course];
        if (!skills) return;

        const pcts = getCoursePcts(course);

        const polygon = document.getElementById(`radar-polygon-${course}`);
        if (polygon) polygon.setAttribute('d', radarPath(pcts, RADAR_R));

        RADAR_ORDER.forEach((skillId, i) => {
          const rad = ((-90 + i * 60) * Math.PI) / 180;
          const r = RADAR_R * pcts[i];
          const dot = document.getElementById(`radar-dot-${skillId}-${course}`);
          if (dot) {
            dot.setAttribute('cx', String(Math.round(rcx + r * Math.cos(rad))));
            dot.setAttribute('cy', String(Math.round(rcy + r * Math.sin(rad))));
          }
        });

        updateBaselineRadars(course);
      }

      function updateBaselineRadars(course) {
        const cfg = RADAR_CONFIG[course];
        if (!cfg.prev || cfg.prev.length === 0) return;

        cfg.prev.forEach((prevCourse, pi) => {
          const boundaryR = RADAR_R * cfg.prevPcts[pi];
          const el = document.getElementById(`radar-baseline-${prevCourse}-on-${course}`);
          if (el) el.setAttribute("d", radarPath(getCoursePcts(prevCourse), boundaryR));
        });
      }

      /* ---- "Jag har klarat" inherit buttons ---- */
      function isCourseFull(course) {
        const skills = allSkillsClient[course];
        if (!skills) return false;
        return skills.every(s => s.goalIds.every(id => states[course][id]));
      }

      function updateInheritButtons() {
        // Kurs C: show "klarat B" button if B is not fully checked
        const inheritC = document.getElementById("inherit-B-on-C");
        if (inheritC) {
          inheritC.classList.toggle("hidden", isCourseFull("B"));
        }

        // Kurs D: show container if either B or C not full
        const inheritD = document.getElementById("inherit-on-D");
        if (inheritD) {
          const bFull = isCourseFull("B");
          const cFull = isCourseFull("C");
          inheritD.classList.toggle("hidden", bFull && cFull);
          const btnB = document.getElementById("inherit-B-on-D-btn");
          if (btnB) btnB.classList.toggle("hidden", bFull);
          const btnC = document.getElementById("inherit-C-on-D-btn");
          if (btnC) btnC.classList.toggle("hidden", cFull);
        }
      }

      function fillCourse(course) {
        const skills = allSkillsClient[course];
        if (!skills) return;
        skills.forEach(s => {
          s.goalIds.forEach(id => { states[course][id] = true; });
        });
        saveState(course, states[course]);

        // Update visual state for filled course
        const panel = document.getElementById(`tree-panel-${course}`);
        if (panel) {
          panel.querySelectorAll('.leaf-node').forEach(leaf => {
            const id = leaf.dataset.goalId;
            leaf.setAttribute('data-checked', 'true');
            leaf.setAttribute('aria-checked', 'true');
            const num = panel.querySelector(`[data-num-for="${id}"]`);
            if (num) num.setAttribute('fill', 'white');
            const branch = panel.querySelector(`[data-branch-for="${id}"]`);
            if (branch) branch.setAttribute('data-checked', 'true');
          });
        }

        skills.forEach(s => {
          updateProgress(course, s.id);
          updateCrown(course, s.id);
        });
        updateRadar(course);

        // Also update baseline radars on courses that depend on this one
        if (course === "B") { updateBaselineRadars("C"); updateBaselineRadars("D"); }
        if (course === "C") { updateBaselineRadars("D"); }

        updateInheritButtons();
      }

      document.querySelectorAll('.inherit-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const fillC = btn.dataset.fillCourse;
          if (confirm(`Alla mål i Kurs ${fillC} markeras som avklarade. Fortsätt?`)) {
            fillCourse(fillC);
          }
        });
      });

      /* ---- Initial render — all courses ---- */
      COURSES.forEach(course => {
        const skills = allSkillsClient[course];
        if (!skills) return;
        skills.forEach(s => {
          updateProgress(course, s.id);
          updateCrown(course, s.id);
        });
        updateRadar(course);
      });

      // Switch to initial course (from URL param or default B)
      if (initialCourse !== "B") {
        switchTreeTab(initialCourse);
      }
      updateInheritButtons();
    </script>
  </body>
</html>
