---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <h1 class="text-3xl font-bold text-gray-900 mt-8 mb-4">
    SFI Spar 2 -- Kursmal
  </h1>
  <p class="text-lg text-gray-600 mb-4">
    Har kan du folja dina kursmal for kurs B, C och D.
  </p>
  <div class="flex gap-4 mt-6">
    <span class="inline-block px-3 py-1 rounded-full text-white text-sm font-semibold bg-domain-hora">Hora</span>
    <span class="inline-block px-3 py-1 rounded-full text-white text-sm font-semibold bg-domain-lasa">Lasa</span>
    <span class="inline-block px-3 py-1 rounded-full text-white text-sm font-semibold bg-domain-prata">Prata</span>
    <span class="inline-block px-3 py-1 rounded-full text-white text-sm font-semibold bg-domain-beratta">Beratta</span>
    <span class="inline-block px-3 py-1 rounded-full text-white text-sm font-semibold bg-domain-skriva">Skriva</span>
  </div>
</BaseLayout>
