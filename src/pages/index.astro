---
import BaseLayout from "../layouts/BaseLayout.astro";
import TabNav from "../components/TabNav.astro";
import CoursePanel from "../components/CoursePanel.astro";
import kursB from "../data/kurs-b.json";
import kursC from "../data/kurs-c.json";
import kursD from "../data/kurs-d.json";
import tokens from "../data/design-tokens.json";
import examples from "../data/examples.json";
import lexinAudio from "../data/lexin-audio.json";
import MinPlanPanel from "../components/MinPlanPanel.astro";
---

<BaseLayout>
  <TabNav />
  <main>
    <CoursePanel course="B" courseData={kursB} tokens={tokens} />
    <CoursePanel course="C" courseData={kursC} tokens={tokens} initiallyHidden={true} />
    <CoursePanel course="D" courseData={kursD} tokens={tokens} initiallyHidden={true} />
    <MinPlanPanel />
  </main>

<script define:vars={{ examples, lexinAudio }}>
  // --- 1. Tab Switching with distinct course colors ---
  const tabs = document.querySelectorAll('.course-tab');
  const panels = document.querySelectorAll('.course-panel');

  const courseColors = {
    B: { border: 'border-cyan-600', text: 'text-cyan-700' },
    C: { border: 'border-violet-600', text: 'text-violet-700' },
    D: { border: 'border-rose-600', text: 'text-rose-700' },
    plan: { border: 'border-emerald-600', text: 'text-emerald-700' },
  };

  let lastActiveCourse = 'B';

  function switchTab(course) {
    if (course !== 'plan') lastActiveCourse = course;
    panels.forEach(p => {
      p.classList.toggle('hidden', p.id !== `panel-${course}`);
    });
    tabs.forEach(t => {
      const isActive = t.dataset.course === course;
      // Remove all color classes first
      Object.values(courseColors).forEach(c => {
        t.classList.remove(c.border, c.text);
      });
      t.classList.remove('border-transparent', 'text-gray-400');

      if (isActive) {
        const colors = courseColors[course];
        t.classList.add(colors.border, colors.text);
      } else {
        t.classList.add('border-transparent', 'text-gray-400');
      }
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      switchTab(tab.dataset.course);
    });
  });

  // --- 2. localStorage Persistence ---
  const STORAGE_KEY = (course) => `sfi-checklist-${course}`;

  function loadState(course) {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY(course)) || '{}');
    } catch {
      return {};
    }
  }

  function saveState(course, state) {
    try {
      localStorage.setItem(STORAGE_KEY(course), JSON.stringify(state));
    } catch {}
  }

  // --- 3. Checkbox Handling + Save Indicator ---
  function showSavedIndicator(goalId) {
    const indicator = document.querySelector(`[data-saved-for="${CSS.escape(goalId)}"]`);
    if (!indicator) return;
    indicator.classList.remove('hidden');
    const clone = indicator.cloneNode(true);
    indicator.parentNode.replaceChild(clone, indicator);
    setTimeout(() => clone.classList.add('hidden'), 1500);
  }

  // --- 4. Progress Counts ---
  function updateProgressCounts(course) {
    const panel = document.getElementById(`panel-${course}`);
    if (!panel) return;
    const progressElements = panel.querySelectorAll('[data-progress]');
    progressElements.forEach(el => {
      const section = el.closest('section');
      if (!section) return;
      const total = section.querySelectorAll('input[type="checkbox"]').length;
      const checked = section.querySelectorAll('input[type="checkbox"]:checked').length;
      el.textContent = `${checked} av ${total} avklarade`;
    });
  }

  document.querySelectorAll('input[type="checkbox"][data-goal-id]').forEach(cb => {
    cb.addEventListener('change', () => {
      const course = cb.dataset.course;
      const goalId = cb.dataset.goalId;
      const state = loadState(course);
      if (cb.checked) {
        state[goalId] = true;
      } else {
        delete state[goalId];
      }
      saveState(course, state);
      showSavedIndicator(goalId);
      updateProgressCounts(course);
    });
  });

  // --- 5. Reset Flow ---
  ['B', 'C', 'D'].forEach(course => {
    const resetBtn = document.querySelector(`[data-reset="${course}"]`);
    const confirmDiv = document.querySelector(`[data-confirm="${course}"]`);
    if (!resetBtn || !confirmDiv) return;

    resetBtn.addEventListener('click', () => {
      resetBtn.classList.add('hidden');
      confirmDiv.classList.remove('hidden');
    });

    confirmDiv.querySelector('.cancel')?.addEventListener('click', () => {
      confirmDiv.classList.add('hidden');
      resetBtn.classList.remove('hidden');
    });

    confirmDiv.querySelector('.confirm')?.addEventListener('click', () => {
      try { localStorage.removeItem(STORAGE_KEY(course)); } catch {}
      document.querySelectorAll(`#panel-${course} input[type="checkbox"]`)
        .forEach(cb => { cb.checked = false; });
      updateProgressCounts(course);
      confirmDiv.classList.add('hidden');
      resetBtn.classList.remove('hidden');
    });
  });

  // --- 6. Expandable Examples ---
  document.querySelectorAll('.expand-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const goalId = btn.dataset.expandFor;
      const details = document.querySelector(`[data-details-for="${CSS.escape(goalId)}"]`);
      const icon = btn.querySelector('.expand-icon');
      if (!details) return;

      const isHidden = details.classList.contains('hidden');
      details.classList.toggle('hidden');
      if (icon) {
        icon.style.transform = isHidden ? 'rotate(180deg)' : '';
      }

      // Load example as list items, split on | separator
      if (isHidden) {
        const exampleEl = document.querySelector(`[data-example-for="${CSS.escape(goalId)}"]`);
        if (exampleEl && examples[goalId]) {
          const text = examples[goalId];
          const parts = text.split('|').filter(s => s.trim());
          exampleEl.innerHTML = parts.map(s =>
            `<li class="text-gray-600 pl-3 border-l-2 border-gray-300">${s.trim()}</li>`
          ).join('');
        } else if (exampleEl) {
          exampleEl.innerHTML = '<li class="text-gray-500 italic">Inget exempel ännu.</li>';
        }
      }
    });
  });

  // --- 7. Lexin Audio Playback ---
  // Uses pre-fetched audio URLs from lexin-audio.json (built at build time, no CORS)
  function playLexinAudio(word, btn) {
    const url = lexinAudio[word];
    if (url) {
      btn.style.opacity = '0.5';
      const audio = new Audio(url);
      audio.play().then(() => {
        audio.onended = () => { btn.style.opacity = '1'; };
      }).catch(() => {
        btn.style.opacity = '1';
        window.open(`https://lexin.nada.kth.se/lexin/#searchinfo=both,swe_swe,${encodeURIComponent(word)}`, '_blank');
      });
    } else {
      window.open(`https://lexin.nada.kth.se/lexin/#searchinfo=both,swe_swe,${encodeURIComponent(word)}`, '_blank');
    }
  }

  // Delegated click handler for dynamically inserted lexin buttons
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-lexin-word]');
    if (btn) {
      e.preventDefault();
      e.stopPropagation();
      playLexinAudio(btn.dataset.lexinWord, btn);
    }
  });

  // --- 8. Initialize on Page Load ---
  ['B', 'C', 'D'].forEach(course => {
    const state = loadState(course);
    Object.entries(state).forEach(([goalId, checked]) => {
      if (checked) {
        const cb = document.querySelector(`[data-goal-id="${CSS.escape(goalId)}"]`);
        if (cb) cb.checked = true;
      }
    });
    updateProgressCounts(course);
  });

  // --- 9. Min Plan Persistence ---
  const PLAN_STORAGE_KEY = 'sfi-minplan';

  function loadPlanState() {
    try {
      return JSON.parse(localStorage.getItem(PLAN_STORAGE_KEY) || '{"checked":{},"custom":{}}');
    } catch {
      return { checked: {}, custom: {} };
    }
  }

  function savePlanState(state) {
    try {
      localStorage.setItem(PLAN_STORAGE_KEY, JSON.stringify(state));
    } catch {}
  }

  const planPanel = document.getElementById('panel-plan');
  if (planPanel) {
    planPanel.addEventListener('change', (e) => {
      const cb = e.target.closest('input[type="checkbox"]');
      if (!cb) return;
      const state = loadPlanState();
      const planId = cb.dataset.planId;
      const customId = cb.dataset.planCustom;
      const key = planId || customId;
      if (key) {
        if (cb.checked) { state.checked[key] = true; }
        else { delete state.checked[key]; }
        savePlanState(state);
      }
    });

    planPanel.addEventListener('input', (e) => {
      const input = e.target.closest('input[type="text"][data-plan-text]');
      if (!input) return;
      const state = loadPlanState();
      state.custom[input.dataset.planText] = input.value;
      savePlanState(state);
    });
  }

  // --- 10. Print Preparation ---
  let prePrintState = null;

  window.addEventListener('beforeprint', () => {
    // Save current panel visibility state
    prePrintState = [];
    document.querySelectorAll('.course-panel').forEach(p => {
      prePrintState.push({ id: p.id, hidden: p.classList.contains('hidden') });
    });

    // Show the last-active course panel + Min plan (D-14, D-15)
    document.querySelectorAll('.course-panel').forEach(p => {
      if (p.id === `panel-${lastActiveCourse}` || p.id === 'panel-plan') {
        p.classList.remove('hidden');
      } else {
        p.classList.add('hidden');
      }
    });

    // Update print header with active course (D-16)
    const printCourse = document.getElementById('print-course');
    if (printCourse) printCourse.textContent = lastActiveCourse;
  });

  window.addEventListener('afterprint', () => {
    // Restore panel visibility
    if (prePrintState) {
      prePrintState.forEach(({ id, hidden }) => {
        const p = document.getElementById(id);
        if (p) p.classList.toggle('hidden', hidden);
      });
      prePrintState = null;
    }
  });

  // --- 11. Initialize Min Plan State ---
  const planState = loadPlanState();
  Object.entries(planState.checked).forEach(([id, checked]) => {
    if (checked) {
      const cb = document.querySelector(`[data-plan-id="${CSS.escape(id)}"]`) ||
                 document.querySelector(`[data-plan-custom="${CSS.escape(id)}"]`);
      if (cb) cb.checked = true;
    }
  });
  Object.entries(planState.custom).forEach(([id, text]) => {
    if (text) {
      const input = document.querySelector(`[data-plan-text="${CSS.escape(id)}"]`);
      if (input) input.value = text;
    }
  });
</script>
</BaseLayout>
