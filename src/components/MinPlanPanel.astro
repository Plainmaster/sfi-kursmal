---
import MinPlanSection from "./MinPlanSection.astro";
import minPlan from "../data/min-plan.json";
import {
  GraduationCap, BookMarked, Library, Globe, Laptop,
  Coffee, Tv, Radio, Play, Calendar
} from "@lucide/astro";

const domainColorMap: Record<string, string> = {
  "horforstaelse": "bg-domain-hora",
  "lasforstaelse": "bg-domain-lasa",
  "muntlig-interaktion": "bg-domain-prata",
  "skriftlig-fardighet": "bg-domain-skriva",
  "digital": "bg-teal-600",
};

const domainIconMap: Record<string, string> = {
  "horforstaelse": "Ear",
  "lasforstaelse": "BookOpen",
  "muntlig-interaktion": "MessagesSquare",
  "skriftlig-fardighet": "PenLine",
  "digital": "Monitor",
};

const resourceIconMap: Record<string, any> = {
  GraduationCap, BookMarked, Library, Globe, Laptop, Coffee, Tv, Radio, Play,
};
---

<div id="panel-plan" class="course-panel pt-4 pb-8 hidden">
  <h2 class="text-2xl font-bold text-gray-800 px-4 mb-1">{minPlan.header}</h2>
  <p class="text-gray-600 px-4 mb-6 text-sm leading-relaxed">{minPlan.intro}</p>

  {/* --- Schedule & Resources FIRST --- */}
  {minPlan.resources && (
    <section class="mb-8">
      <div class="bg-gray-700 rounded-t-lg px-4 py-3 flex items-center gap-2">
        <Calendar size={24} class="text-white" />
        <h2 class="text-white font-semibold text-lg">{minPlan.resources.header}</h2>
      </div>
      <div class="bg-white rounded-b-lg border border-t-0 border-gray-200">
        {minPlan.resources.intro && (
          <div class="px-4 py-3 border-b border-gray-200 bg-amber-50">
            <p class="text-sm text-gray-800 font-medium leading-relaxed">{minPlan.resources.intro}</p>
          </div>
        )}

        {minPlan.resources.calendar && (
          <div class="px-4 py-3 border-b border-gray-200 print-hide">
            <iframe
              src={minPlan.resources.calendar}
              class="w-full rounded border border-gray-200"
              style="height: 400px;"
              frameborder="0"
              scrolling="no"
            ></iframe>
          </div>
        )}

        <div class="divide-y divide-gray-100">
          {minPlan.resources.items.map((item) => {
            const IconComp = item.icon ? resourceIconMap[item.icon] : null;
            return (
              <div class="flex items-center gap-3 py-3 px-4">
                {IconComp && (
                  <span class="shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 text-gray-600">
                    <IconComp size={18} />
                  </span>
                )}
                {item.link ? (
                  <a href={item.link} target="_blank" rel="noopener" class="text-blue-600 hover:text-blue-800 text-sm font-medium">
                    {item.text} <span class="text-blue-400">↗</span>
                  </a>
                ) : (
                  <p class="text-sm text-gray-700">{item.text}</p>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {/* --- Skill domains with checkboxes --- */}
  {minPlan.domains.map((domain) => {
    const icon = domainIconMap[domain.key] || "BookOpen";
    const color = domainColorMap[domain.key] || "bg-gray-600";
    return (
      <MinPlanSection
        domainKey={domain.key}
        label={domain.label}
        icon={icon}
        colorClass={color}
        items={domain.items}
        customRowCount={2}
      />
    );
  })}

  <div class="px-4 pt-2">
    <button
      class="print-hide text-gray-500 border border-gray-300 rounded-lg px-4 py-2 text-sm hover:bg-gray-50 transition-colors"
      onclick="window.print()"
    >
      Skriv ut
    </button>
  </div>
</div>
