---
import minPlan from "../data/min-plan.json";
import {
  GraduationCap, BookMarked, Library, Globe, Laptop,
  Coffee, Tv, Radio, Play, Calendar, Lock
} from "@lucide/astro";

const resourceIconMap: Record<string, any> = {
  GraduationCap, BookMarked, Library, Globe, Laptop, Coffee, Tv, Radio, Play,
};

const resources = minPlan.resources;
const schoolItems = resources.items.filter(i => i.school);
const openItems = resources.items.filter(i => !i.school);
---

<div id="panel-resurser" class="course-panel pt-4 pb-8 hidden">
  <h2 class="text-2xl font-bold text-gray-800 px-4 mb-2">Resurser och stöd</h2>
  <p class="text-gray-600 px-4 mb-6 text-sm leading-relaxed">
    Här hittar du hjälp och verktyg för att lära dig svenska. Allt är gratis.
  </p>

  {resources.intro && (
    <div class="mx-4 mb-6 px-4 py-3 rounded-lg bg-amber-50 border border-amber-200">
      <div class="flex items-center gap-2 mb-1">
        <Calendar size={18} class="text-amber-700" />
        <p class="text-sm text-amber-800 font-bold">Tider att komma ihåg</p>
      </div>
      <p class="text-sm text-amber-800 leading-relaxed">{resources.intro}</p>
    </div>
  )}

  {resources.calendar && (
    <div class="mx-4 mb-6 print-hide">
      <p class="text-xs text-gray-500 mb-2 font-medium">Schema — Lärcentrum Kompassen</p>
      <iframe
        src={resources.calendar}
        class="w-full rounded-lg border border-gray-200"
        style="height: 400px;"
        frameborder="0"
        scrolling="no"
      ></iframe>
    </div>
  )}

  {/* --- School login required --- */}
  {schoolItems.length > 0 && (
    <div class="px-4 mb-6">
      <div class="flex items-center gap-2 mb-3">
        <Lock size={16} class="text-indigo-600" />
        <p class="text-sm font-bold text-gray-700">Skolans verktyg</p>
      </div>

      <a
        href="https://lund.se/skolportalen"
        target="_blank"
        rel="noopener"
        class="block mb-3 rounded-lg border-2 border-indigo-300 bg-indigo-50 hover:bg-indigo-100 transition-all p-4"
      >
        <div class="flex items-center gap-3">
          <span class="shrink-0 w-12 h-12 flex items-center justify-center rounded-full bg-indigo-600 text-white">
            <Globe size={24} />
          </span>
          <div>
            <p class="text-base font-bold text-indigo-800">Skolportalen — Logga in här</p>
            <p class="text-sm text-indigo-600">lund.se/skolportalen → Elev → Välj ditt verktyg</p>
          </div>
        </div>
        <p class="text-xs text-indigo-500 mt-2 ml-15">Använd ditt skolkonto (@skola.lund.se). Här hittar du Inläsningstjänst, Lunis och mer.</p>
      </a>

      <p class="text-xs text-gray-500 mb-3">
        Länkarna nedan kräver att du är inloggad med ditt skolkonto i Chrome.
      </p>
      <div class="space-y-3">
        {schoolItems.map((item) => {
          const IconComp = item.icon ? resourceIconMap[item.icon] : null;
          return (
            <a
              href={item.link}
              target="_blank"
              rel="noopener"
              class="block rounded-lg border border-indigo-100 bg-white hover:border-indigo-300 hover:shadow-sm transition-all p-4"
            >
              <div class="flex items-start gap-3">
                {IconComp && (
                  <span class="shrink-0 w-10 h-10 flex items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
                    <IconComp size={20} />
                  </span>
                )}
                <div class="flex-1 min-w-0">
                  <p class="text-base font-semibold text-gray-800 mb-0.5">
                    {item.text} <span class="text-indigo-400 text-xs font-normal">skolkonto ↗</span>
                  </p>
                  {item.desc && (
                    <p class="text-sm text-gray-500 leading-relaxed">{item.desc}</p>
                  )}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  )}

  {/* --- Open for everyone --- */}
  {openItems.length > 0 && (
    <div class="px-4 mb-6">
      <p class="text-sm font-bold text-gray-700 mb-3">Öppet för alla</p>
      <div class="space-y-3">
        {openItems.map((item) => {
          const IconComp = item.icon ? resourceIconMap[item.icon] : null;
          return (
            <a
              href={item.link}
              target="_blank"
              rel="noopener"
              class="block rounded-lg border border-gray-200 bg-white hover:border-blue-300 hover:shadow-sm transition-all p-4"
            >
              <div class="flex items-start gap-3">
                {IconComp && (
                  <span class="shrink-0 w-10 h-10 flex items-center justify-center rounded-full bg-blue-50 text-blue-600">
                    <IconComp size={20} />
                  </span>
                )}
                <div class="flex-1 min-w-0">
                  <p class="text-base font-semibold text-gray-800 mb-0.5">
                    {item.text} <span class="text-blue-400 text-sm">↗</span>
                  </p>
                  {item.desc && (
                    <p class="text-sm text-gray-500 leading-relaxed">{item.desc}</p>
                  )}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  )}
</div>
