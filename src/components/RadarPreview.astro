---
interface DemoSkill {
  id: string;
  label: string;
  color: string;
  pct: number;
}
interface Props {
  skills: DemoSkill[];
  labelStyle: "bigColored" | "chips" | "darkWithDot";
}
const { skills, labelStyle } = Astro.props;

const RADAR_CX = 150, RADAR_CY = 150, RADAR_R = 110;

const axes = skills.map((s, i) => {
  const angleDeg = -90 + i * 60;
  const rad = (angleDeg * Math.PI) / 180;
  const cos = Math.cos(rad), sin = Math.sin(rad);
  const anchor = i === 0 || i === 3 ? "middle" : i < 3 ? "start" : "end";
  const lblR = RADAR_R + 22;
  return {
    ...s,
    cos, sin,
    ex: Math.round(RADAR_CX + RADAR_R * cos),
    ey: Math.round(RADAR_CY + RADAR_R * sin),
    lx: Math.round(RADAR_CX + lblR * cos),
    ly: Math.round(RADAR_CY + lblR * sin + (i === 0 ? -4 : i === 3 ? 14 : 5)),
    anchor,
  };
});

function smoothClosedPath(points: { x: number; y: number }[], tension = 0.22) {
  const n = points.length;
  if (n < 2) return "";
  let d = `M${points[0].x.toFixed(1)},${points[0].y.toFixed(1)}`;
  for (let i = 0; i < n; i++) {
    const p0 = points[(i - 1 + n) % n];
    const p1 = points[i];
    const p2 = points[(i + 1) % n];
    const p3 = points[(i + 2) % n];
    const cp1x = p1.x + (p2.x - p0.x) * tension;
    const cp1y = p1.y + (p2.y - p0.y) * tension;
    const cp2x = p2.x - (p3.x - p1.x) * tension;
    const cp2y = p2.y - (p3.y - p1.y) * tension;
    d += ` C${cp1x.toFixed(1)},${cp1y.toFixed(1)} ${cp2x.toFixed(1)},${cp2y.toFixed(1)} ${p2.x.toFixed(1)},${p2.y.toFixed(1)}`;
  }
  return d + " Z";
}

const dataPoints = skills.map((s, i) => {
  const rad = ((-90 + i * 60) * Math.PI) / 180;
  return {
    x: RADAR_CX + RADAR_R * s.pct * Math.cos(rad),
    y: RADAR_CY + RADAR_R * s.pct * Math.sin(rad),
  };
});
const dataPath = smoothClosedPath(dataPoints);

const ringSteps = [0.25, 0.5, 0.75, 1];
---

<svg viewBox="-40 -10 380 320" class="w-full">
  {/* Concentric grid */}
  {ringSteps.map((pct) => (
    <circle
      cx={RADAR_CX}
      cy={RADAR_CY}
      r={Math.round(RADAR_R * pct * 10) / 10}
      fill="none"
      stroke="#E7E5E4"
      stroke-width={pct === 1 ? "1.2" : "0.7"}
      opacity={pct === 1 ? "1" : "0.5"}
    />
  ))}

  {/* Axes */}
  {axes.map((a) => (
    <line x1={RADAR_CX} y1={RADAR_CY} x2={a.ex} y2={a.ey} stroke="#D6D3D1" stroke-width="1" />
  ))}

  {/* Data shape — smooth */}
  <path d={dataPath} fill="rgba(34,197,94,0.12)" stroke="#22C55E" stroke-width="2.5" stroke-linejoin="round" />

  {/* Data dots */}
  {axes.map((a) => {
    const r = RADAR_R * a.pct;
    return <circle cx={Math.round(RADAR_CX + r * a.cos)} cy={Math.round(RADAR_CY + r * a.sin)} r="5" fill={a.color} />;
  })}

  {/* Labels — variant L1: stora färgade */}
  {labelStyle === "bigColored" && axes.map((a) => (
    <text x={a.lx} y={a.ly} text-anchor={a.anchor} font-size="15" font-weight="700" fill={a.color}>{a.label}</text>
  ))}

  {/* Labels — variant L2: pill-chips */}
  {labelStyle === "chips" && axes.map((a) => {
    const w = a.label.length * 7.5 + 16;
    const h = 22;
    let rectX;
    if (a.anchor === "middle") rectX = a.lx - w / 2;
    else if (a.anchor === "start") rectX = a.lx - 8;
    else rectX = a.lx - w + 8;
    const rectY = a.ly - 15;
    return (
      <>
        <rect x={rectX} y={rectY} width={w} height={h} rx="11" fill={`${a.color}1A`} stroke={a.color} stroke-width="1.3" />
        <text x={a.lx} y={a.ly} text-anchor={a.anchor} font-size="13" font-weight="700" fill={a.color}>{a.label}</text>
      </>
    );
  })}

  {/* Labels — variant L3: mörk text + färgad prick */}
  {labelStyle === "darkWithDot" && axes.map((a) => {
    let dotX: number, dotY: number;
    if (a.anchor === "middle") { dotX = a.lx; dotY = a.ly - 17; }
    else if (a.anchor === "start") { dotX = a.lx - 10; dotY = a.ly - 4; }
    else { dotX = a.lx + 10; dotY = a.ly - 4; }
    return (
      <>
        <circle cx={dotX} cy={dotY} r="4.5" fill={a.color} />
        <text x={a.lx} y={a.ly} text-anchor={a.anchor} font-size="15" font-weight="700" fill="#1F2937">{a.label}</text>
      </>
    );
  })}
</svg>
