---
interface Props {
  course: string;
}

const { course } = Astro.props;
---

<div class="text-center mt-4 mb-2">
  <button
    data-reset={course}
    class="text-sm text-gray-400 underline hover:text-gray-600 py-2"
  >
    Börja om
  </button>
  <div
    data-confirm={course}
    class="hidden bg-yellow-50 border border-yellow-200 rounded-lg p-4 text-center mt-2"
  >
    <p class="text-sm text-gray-700 mb-3">
      Är du säker? Alla markeringar för Kurs {course} försvinner.
    </p>
    <button class="confirm bg-red-500 text-white px-4 py-2 rounded-lg mr-2 min-h-[44px]">
      Ja, börja om
    </button>
    <button class="cancel bg-gray-200 text-gray-700 px-4 py-2 rounded-lg min-h-[44px]">
      Avbryt
    </button>
  </div>
</div>
