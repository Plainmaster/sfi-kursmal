---
import { Ear, BookOpen, MessageCircle, Mic, PenLine } from "@lucide/astro";
import GoalCheckbox from "./GoalCheckbox.astro";

interface Props {
  domainKey: string;
  label: string;
  icon: string;
  colorClass: string;
  goals: Array<{ id: string; text: string }>;
  course: string;
}

const { domainKey, label, icon, colorClass, goals, course } = Astro.props;

const iconMap: Record<string, any> = { Ear, BookOpen, MessageCircle, Mic, PenLine };
const IconComponent = iconMap[icon];
---

<section class="mb-6">
  <div class={`${colorClass} rounded-t-lg px-4 py-3 flex items-center gap-2`}>
    {IconComponent && <IconComponent size={24} class="text-white" />}
    <h2 class="text-white font-semibold text-lg">{label}</h2>
  </div>
  <p
    class="text-sm text-gray-500 px-4 py-1"
    data-progress={`${course}-${domainKey}`}
  >
    0 av {goals.length} avklarade
  </p>
  <div class="bg-white rounded-b-lg border border-t-0 border-gray-200 divide-y divide-gray-100">
    {goals.map((goal) => (
      <GoalCheckbox id={goal.id} text={goal.text} course={course} />
    ))}
  </div>
</section>
