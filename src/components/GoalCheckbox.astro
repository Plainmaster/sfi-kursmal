---
interface Props {
  id: string;
  text: string;
  course: string;
}

const { id, text, course } = Astro.props;
---

<div class="goal-item relative border-b border-gray-100 last:border-b-0">
  <div class="flex items-center gap-3 py-2 px-3 min-h-[44px]">
    <label class="flex items-center gap-3 flex-1 cursor-pointer">
      <input
        type="checkbox"
        class="w-6 h-6 shrink-0 accent-current"
        data-goal-id={id}
        data-course={course}
      />
      <span class="text-base flex-1">{text}</span>
    </label>
    <button
      class="tts-btn shrink-0 w-8 h-8 flex items-center justify-center text-gray-400 hover:text-gray-600 rounded-full hover:bg-gray-100 transition-colors"
      data-tts-text={text}
      aria-label="Lyssna"
      type="button"
      title="Lyssna på texten"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
        <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
        <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
      </svg>
    </button>
    <span
      class="saved-indicator absolute right-12 top-1/2 -translate-y-1/2 pointer-events-none bg-green-100 text-green-700 text-xs font-medium px-2 py-0.5 rounded-full shadow-sm hidden"
      data-saved-for={id}
    >
      Sparat!
    </span>
    <button
      class="expand-btn shrink-0 w-8 h-8 flex items-center justify-center text-gray-400 hover:text-gray-600 rounded-full hover:bg-gray-100 transition-colors"
      data-expand-for={id}
      aria-label="Visa exempel"
      type="button"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="expand-icon transition-transform">
        <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
  <div class="goal-details hidden px-4 pb-3 ml-9" data-details-for={id}>
    <div class="bg-gray-50 rounded-lg p-3 text-sm text-gray-600 border border-gray-200">
      <p class="font-medium text-gray-700 mb-2">Exempel:</p>
      <ul class="space-y-1 list-none" data-example-for={id}>
        <li class="text-gray-500 italic">Laddar...</li>
      </ul>
    </div>
  </div>
</div>
